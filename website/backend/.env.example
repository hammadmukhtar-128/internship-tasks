# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string. Database name must be clinic_management.
# Example: mongodb+srv://USERNAME:PASSWORD@cluster0.zvbra4u.mongodb.net/clinic_management
MONGODB_URI=

# The frontend's origin, for CORS (must be exact — no trailing slash).
FRONTEND_URL=http://localhost:5173

# Admin authentication
ADMIN_EMAIL=
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=

# Secret used to sign admin session JWTs (use a long random string)
JWT_SECRET=

# SMTP configuration for booking / contact notification emails (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
